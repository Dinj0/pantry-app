generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model Namirnica {
  id              Int      @id @default(autoincrement())
  naziv           String
  trenutnaKolicina Int
  minKolicina     Int
  targetKolicina  Int
  kategorija      String
  lokacija        String
  isLocked        Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model PotrosenaNamirnica {
  id              Int      @id @default(autoincrement())
  naziv           String
  kategorija      String
  lokacija        String
  potrosenoDatum  DateTime @default(now())
}

model Kategorija {
  id     Int    @id @default(autoincrement())
  naziv  String @unique
}

model ShoppingStavka {
  id        Int      @id @default(autoincrement())
  naziv     String
  createdAt DateTime @default(now())
}

