generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Namirnica {
  id                 Int      @id @default(autoincrement())
  ime                String
  trenutnaKolicina   Int
  minKolicina        Int
  ciljanaKolicina    Int
  kategorija         String
  lokacija           String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}